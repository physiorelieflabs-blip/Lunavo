# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.

NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example

# PostgreSQL — self-hosted source of truth
DATABASE_URL=

# Self-hosted intelligence (OpenAI-compatible local runtime by default)
# Example local runtime: Ollama-compatible endpoint on loopback.
LUNAVO_LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1
LUNAVO_LOCAL_AI_MODEL=llama3.3
LUNAVO_LOCAL_AI_TIMEOUT_MS=60000

# Self-hosted image generation adapter
LUNAVO_LOCAL_IMAGE_URL=http://127.0.0.1:8188
LUNAVO_LOCAL_IMAGE_TIMEOUT_MS=180000

# Flutterwave — the deliberate external payment-rail boundary
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy aliases accepted for existing deployments:
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# Optional social publishing adapters. Core content creation/export remains local.
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=

# Self-hosted object/media storage is preferred. S3-compatible storage may be a local MinIO instance.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=lunavo
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Self-hosted email delivery is preferred via local SMTP/Mailpit/Postfix.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Legacy/optional hosted adapters — not required by the core platform.
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
