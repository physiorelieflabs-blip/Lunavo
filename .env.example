# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.
# Lunavo core is self-hosted-first. Flutterwave is the only external real-money rail.
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example
POSTGRES_PASSWORD=
# Self-hosted PostgreSQL dumps are kept on a separate local Docker volume.
# This protects against accidental database corruption, not loss of the Docker host.
LUNAVO_BACKUP_RETENTION_DAYS=14
LUNAVO_BACKUP_INTERVAL_SECONDS=86400
VITE_ALLOWED_HOSTS=
DATABASE_URL=
SESSION_SECRET=

# One-time Master Admin bootstrap inputs. Never commit a real password.
LUNAVO_MASTER_ADMIN_EMAIL=
LUNAVO_MASTER_ADMIN_USERNAME=tsadmin
LUNAVO_MASTER_ADMIN_PASSWORD=

# ---------------- Self-hosted intelligence fabric ----------------
# Use one local OpenAI-compatible endpoint (Ollama, LocalAI, vLLM, etc.).
# Role-specific URLs are optional; when blank they use the shared endpoint.
LUNAVO_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LUNAVO_LOCAL_LLM_MODEL=qwen3:14b
LUNAVO_LOCAL_MODEL_PACK=qwen3:4b,qwen3:14b,deepseek-r1:14b,gemma3:12b,nomic-embed-text
LUNAVO_LOCAL_AI_BASE_URL=http://127.0.0.1:11434/v1

# Real local model defaults. Pull these models into your local runtime.
LUNAVO_LOCAL_AI_FAST_MODEL=qwen3:4b
LUNAVO_LOCAL_AI_GENERAL_MODEL=qwen3:14b
LUNAVO_LOCAL_AI_REASONING_MODEL=deepseek-r1:14b
LUNAVO_LOCAL_AI_CODING_MODEL=qwen3-coder:30b
LUNAVO_LOCAL_AI_VISION_MODEL=gemma3:12b
LUNAVO_LOCAL_AI_REVIEW_MODEL=gemma3:12b

# Optional per-profile endpoints for separate GPU/CPU workers.
LUNAVO_LOCAL_AI_FAST_URL=
LUNAVO_LOCAL_AI_GENERAL_URL=
LUNAVO_LOCAL_AI_REASONING_URL=
LUNAVO_LOCAL_AI_CODING_URL=
LUNAVO_LOCAL_AI_VISION_URL=
LUNAVO_LOCAL_AI_REVIEW_URL=

# Optional dedicated local routes for specialist brains. These override the
# profile's primary model/endpoint; a missing value inherits the profile route.
# Every URL must point to a private/local OpenAI-compatible chat-completions endpoint.
LUNAVO_LOCAL_AI_ROLE_ORCHESTRATOR_URL=
LUNAVO_LOCAL_AI_ROLE_ORCHESTRATOR_MODEL=
LUNAVO_LOCAL_AI_ROLE_RESEARCHER_URL=
LUNAVO_LOCAL_AI_ROLE_RESEARCHER_MODEL=
LUNAVO_LOCAL_AI_ROLE_MERCHANDISER_URL=
LUNAVO_LOCAL_AI_ROLE_MERCHANDISER_MODEL=
LUNAVO_LOCAL_AI_ROLE_GROWTH_URL=
LUNAVO_LOCAL_AI_ROLE_GROWTH_MODEL=
LUNAVO_LOCAL_AI_ROLE_OPERATIONS_URL=
LUNAVO_LOCAL_AI_ROLE_OPERATIONS_MODEL=
LUNAVO_LOCAL_AI_ROLE_CUSTOMER_URL=
LUNAVO_LOCAL_AI_ROLE_CUSTOMER_MODEL=
LUNAVO_LOCAL_AI_ROLE_FINANCE_URL=
LUNAVO_LOCAL_AI_ROLE_FINANCE_MODEL=
LUNAVO_LOCAL_AI_ROLE_CREATIVE_URL=
LUNAVO_LOCAL_AI_ROLE_CREATIVE_MODEL=
LUNAVO_LOCAL_AI_ROLE_REVIEWER_URL=
LUNAVO_LOCAL_AI_ROLE_REVIEWER_MODEL=
LUNAVO_LOCAL_AI_ROLE_CODER_URL=
LUNAVO_LOCAL_AI_ROLE_CODER_MODEL=
LUNAVO_LOCAL_AI_ARBITER_URL=
LUNAVO_LOCAL_AI_ARBITER_MODEL=qwen3:4b

# Local retrieval/embeddings.
LUNAVO_LOCAL_EMBEDDINGS_URL=http://127.0.0.1:11434/v1/embeddings
LUNAVO_LOCAL_EMBEDDINGS_MODEL=nomic-embed-text

# Self-hosted vision/image/video workers.
LUNAVO_LOCAL_IMAGE_URL=
LUNAVO_LOCAL_IMAGE_MODEL=local-image
LUNAVO_LOCAL_VIDEO_URL=
LUNAVO_LOCAL_VIDEO_MODEL=local-video
LUNAVO_LOCAL_IMAGE_TIMEOUT_MS=180000
LUNAVO_LOCAL_VIDEO_TIMEOUT_MS=1800000

# Self-hosted mail/object storage.
LUNAVO_LOCAL_OBJECT_STORAGE_PATH=/data/lunavo
LUNAVO_LOCAL_MAIL_FROM=no-reply@lunavo.local

# ---------------- Flutterwave: the only external money rail ----------------
# Leave blank and Lunavo still launches; real-money features stay disabled until configured.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy aliases:
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# ---------------- Self-hosted social gateway ----------------
# Required shared secret between Lunavo and the isolated local gateway; generate a long random value.
SOCIAL_GATEWAY_TOKEN=
# Provider OAuth credentials belong in the separately deployed/self-hosted gateway,
# not in Lunavo core. The gateway keeps external social APIs behind a local boundary.
LUNAVO_SOCIAL_GATEWAY_URL=http://social-gateway:8080
LUNAVO_SOCIAL_GATEWAY_TOKEN=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=
