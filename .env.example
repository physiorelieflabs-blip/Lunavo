# Lunavo production environment template
# NEVER commit real secrets. Put real values in Replit Secrets / deployment secrets.

NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example

# PostgreSQL
DATABASE_URL=

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Flutterwave payment rail
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=

# Social publishing / OAuth (required only for the providers you enable)
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=

# Optional AI integrations; leave blank when using Lunavo's local/deterministic logic
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional object/media storage integrations, when enabled by the deployment
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional email/SMS integrations, when enabled by the deployment
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
