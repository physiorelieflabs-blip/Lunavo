# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.
# Core Lunavo capabilities are self-hosted and must not require third-party API keys.

NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example

# PostgreSQL — Lunavo's authoritative application database
DATABASE_URL=

# Optional local/self-hosted service endpoints.
# Leave blank to use Lunavo's built-in local implementations.
LUNAVO_LOCAL_LLM_URL=
LUNAVO_LOCAL_EMBEDDINGS_URL=
LUNAVO_LOCAL_OBJECT_STORAGE_PATH=
LUNAVO_LOCAL_MAIL_FROM=

# Flutterwave is the initial real-money payment rail.
# These are the only provider secrets required by Lunavo core.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy aliases are accepted by existing deployments:
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# Optional third-party adapters may be configured only when a merchant/admin
# explicitly enables that integration. They are never required for Lunavo core.
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=

# SMTP is an optional transport adapter. Lunavo's notification/outbox logic
# remains first-party and can run without SMTP during local development.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
