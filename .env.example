# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.
# Core Lunavo capabilities are self-hosted and do not require third-party API keys.
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example
VITE_ALLOWED_HOSTS=
DATABASE_URL=
SESSION_SECRET=
# Optional one-time bootstrap settings (do not keep the password in source control).
LUNAVO_MASTER_ADMIN_EMAIL=admin@example.com
LUNAVO_MASTER_ADMIN_USERNAME=tsadmin
LUNAVO_MASTER_ADMIN_PASSWORD=
# Required when bootstrapping/using the Master Admin identity unless LUNAVO_MASTER_ADMIN_USER_ID is supplied.

# Self-hosted capability endpoints. No third-party API key is required by Lunavo core.
LUNAVO_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LUNAVO_LOCAL_LLM_MODEL=qwen3:8b
LUNAVO_LOCAL_IMAGE_URL=
LUNAVO_LOCAL_IMAGE_MODEL=local-image
LUNAVO_LOCAL_EMBEDDINGS_URL=
LUNAVO_LOCAL_SEARCH_URL=
LUNAVO_LOCAL_OBJECT_STORAGE_PATH=/data/lunavo
LUNAVO_LOCAL_MAIL_FROM=

# Flutterwave is the only external provider used for real-money payments.
# Leave blank and Lunavo still launches; payment features remain disabled until configured.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy aliases:
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# External social platforms are optional destinations, not Lunavo core dependencies.
# Their provider credentials belong in an isolated connector/gateway, not core configuration.
LUNAVO_SOCIAL_GATEWAY_URL=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=

# Optional self-hosted mail transport.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM= Core notification/outbox records remain first-party.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
