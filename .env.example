# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.
# Core Lunavo capabilities are self-hosted. Flutterwave is the only required external payment provider.
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example
VITE_ALLOWED_HOSTS=
DATABASE_URL=
SESSION_SECRET=

# Master Admin bootstrap (one-time; never commit a real password).
LUNAVO_MASTER_ADMIN_EMAIL=admin@example.com
LUNAVO_MASTER_ADMIN_USERNAME=tsadmin
LUNAVO_MASTER_ADMIN_PASSWORD=

# Self-hosted intelligence/services. No third-party AI/search/storage/mail API keys.
LUNAVO_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
LUNAVO_LOCAL_LLM_MODEL=qwen3:32b
LUNAVO_LOCAL_VISION_MODEL=qwen2.5vl:32b
LUNAVO_LOCAL_SEARCH_URL=http://127.0.0.1:8080/search
LUNAVO_LOCAL_IMAGE_URL=http://127.0.0.1:7860/sdapi/v1/txt2img
LUNAVO_LOCAL_EMBEDDINGS_URL=
LUNAVO_LOCAL_OBJECT_STORAGE_PATH=
LUNAVO_LOCAL_MAIL_FROM=

# Flutterwave is the only external provider whose credentials are required for real-money payments.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# External social-network publishing is isolated and optional because destination networks require their own OAuth applications.
# These credentials are never required for Lunavo core operation.
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_LINKEDIN_API_VERSION=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=

# Optional local SMTP transport. Notifications/outbox remain first-party.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Self-hosted AI brain: comma-separated local OpenAI-compatible/Ollama/llama.cpp endpoints.
LUNAVO_LOCAL_LLM_URLS=http://127.0.0.1:11434/v1/chat/completions,http://127.0.0.1:11435/v1/chat/completions
LUNAVO_LOCAL_LLM_MODEL=qwen3:32b
LUNAVO_LOCAL_FAST_MODEL=qwen3:14b
LUNAVO_LOCAL_VISION_MODEL=qwen2.5vl:32b
LUNAVO_LOCAL_CRITIC_MODEL=qwen3:32b
LUNAVO_LOCAL_BRAIN_FANOUT=2
