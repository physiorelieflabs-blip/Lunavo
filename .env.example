# Lunavo production environment template
# NEVER commit real secrets. Put real values in deployment secrets.
# Core Lunavo capabilities are self-hosted and do not require third-party API keys.
NODE_ENV=production
PORT=5000
APP_BASE_URL=https://YOUR-LUNAVO-DOMAIN.example
DATABASE_URL=
SESSION_SECRET=
LUNAVO_MASTER_ADMIN_SETUP_TOKEN=

# Optional self-hosted service endpoints. Leave blank to use built-in local implementations.
LUNAVO_LOCAL_LLM_URL=
LUNAVO_LOCAL_EMBEDDINGS_URL=
LUNAVO_LOCAL_SEARCH_URL=
LUNAVO_LOCAL_OBJECT_STORAGE_PATH=
LUNAVO_LOCAL_MAIL_FROM=

# Flutterwave is the only external provider used for real-money payments.
# Leave blank and Lunavo still launches; payment features remain disabled until configured.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
# Legacy aliases:
# FLW_SECRET_KEY=
# FLW_WEBHOOK_HASH=

# Optional social-network adapters; never required by Lunavo core.
SOCIAL_META_CLIENT_ID=
SOCIAL_META_CLIENT_SECRET=
SOCIAL_TIKTOK_CLIENT_KEY=
SOCIAL_TIKTOK_CLIENT_SECRET=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SOCIAL_LINKEDIN_CLIENT_ID=
SOCIAL_LINKEDIN_CLIENT_SECRET=
SOCIAL_PINTEREST_CLIENT_ID=
SOCIAL_PINTEREST_CLIENT_SECRET=
SOCIAL_X_CLIENT_ID=
SOCIAL_X_CLIENT_SECRET=
SOCIAL_OAUTH_CALLBACK_URL=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_IDEMPOTENCY_SECRET=

# Optional self-hosted SMTP transport. Core notification/outbox records remain first-party.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
