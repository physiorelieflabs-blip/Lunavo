modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "ffmpeg"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
WHOP_COMPANY_ID = "biz_m86mV7hZtDYXp6"
WHOP_PLAN_ID = "plan_d1AsucJpgR7M1"
WHOP_PRODUCT_ID = "prod_apQzCF0Or2rVx"
WHOP_CUSTOMER_PRODUCT_ID = "prod_dItH1N3D8iXw4"
